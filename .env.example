# Database
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/lms_db"
DB_USER=lms_user
DB_PASSWORD=change_me_strong_password
DB_NAME=lms_db

# Redis
REDIS_URL="redis://:change_me_redis_password@localhost:6379"
REDIS_PASSWORD=change_me_redis_password

# NextAuth
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Providers — add keys only for the ones you want to use
DEFAULT_AI_PROVIDER=ANTHROPIC

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini
GEMINI_API_KEY=AIza...

# OpenRouter (access to 200+ models with one key)
OPENROUTER_API_KEY=sk-or-...

# Your app's public URL (required for OpenRouter's HTTP-Referer header)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lms-assets
R2_PUBLIC_URL=https://your-r2-subdomain.r2.dev

# API
API_URL=http://localhost:4000
API_SECRET=internal_api_secret_key

# App
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NODE_ENV=development
